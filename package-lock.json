        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/plugin-gattify": {
      "name": "tauri-plugin-gattify-api",
      "version": "0.1.0",
      "license": "MIT",
      "devDependencies": {
        "@tauri-apps/api": "^2.8.0",
        "typescript": "^5.9.2"
      },
      "peerDependencies": {
        "@tauri-apps/api": ">=2.0.0 <3"
      }
    }
