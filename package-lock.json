{
  "name": "gattify-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "gattify-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "examples/*"
      ]
    },
    "examples/offline-chat": {
      "name": "gattify-offline-chat-example",
      "version": "0.1.0",
      "devDependencies": {
        "typescript": "^5.9.2"
      }
    },
    "node_modules/@tauri-apps/api": {
      "version": "2.11.1",
      "resolved": "https://registry.npmjs.org/@tauri-apps/api/-/api-2.11.1.tgz",
      "integrity": "sha512-M2FPuYND2m+wh5hfW9ZpSdxMPdEJovPBWwoHJmwUpysTYNHaOkVFN419m/K0LIgjb/7KU2vBgsUepJWugQCvAA==",
      "dev": true,
      "license": "Apache-2.0 OR MIT",
      "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/tauri"
      }
    },
    "node_modules/gattify-offline-chat-example": {
      "resolved": "examples/offline-chat",
      "link": true
    },
    "node_modules/tauri-plugin-gattify-api": {
      "resolved": "packages/plugin-gattify",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
