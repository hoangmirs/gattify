{
  "name": "tauri-plugin-gattify-api",
  "version": "0.1.0-alpha.1",
  "description": "Framework-neutral TypeScript facade for tauri-plugin-gattify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangmirs/gattify.git",
    "directory": "packages/plugin-gattify"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./peer": {
      "types": "./dist/peer.d.ts",
      "import": "./dist/peer.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
